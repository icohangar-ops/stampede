    "check": "npm test && npm run build:api && npm run smoke:api && npm run build --prefix web"
  },
  "dependencies": {
    "@vercel/functions": "^3.1.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.5",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22"
  }
}
