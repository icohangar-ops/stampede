{
  "name": "stampede",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "tsx --test server/lib/*.test.ts",
    "build:api": "node scripts/bundle-api.mjs",
    "smoke:api": "node scripts/smoke-api.mjs",
    "build": "npm run build:api && npm run build --prefix web",
